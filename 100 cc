#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *fptr = fopen("file.txt", "r");
    char str[100];

    if (fptr == NULL) {
        printf("Error opening file!\n");
        exit(1);
    }

    if (fgets(str, sizeof(str), fptr) != NULL) {
        printf("First line: %s", str);
    }

    fclose(fptr);
    return 0;
}
